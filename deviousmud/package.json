{
  "name": "deviousmud",
  "version": "1.0.0",
  "private": true,
  "description": "DeviousMud - a family-friendly, tile-based HTML5 MMORPG with a zero-dependency Node.js game server.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "build": "node tools/bundle.mjs",
    "icons": "node tools/make-icons.mjs",
    "android:sync": "node tools/sync-android.mjs"
  },
  "license": "MIT"
}
